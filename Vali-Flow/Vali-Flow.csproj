<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
        <RootNamespace>Vali_Flow</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- NU1608: EFCore.BulkExtensions 8.1.3 is compatible with both .NET 8 and 9.
             Pomelo/Oracle mismatch warnings are transitive and don't affect published packages. -->
        <NoWarn>$(NoWarn);NU1608</NoWarn>

        <!-- Package identity -->
        <PackageId>Vali-Flow</PackageId>
        <Title>Vali-Flow</Title>
        <Product>Vali-Flow</Product>
        <Version>1.3.4</Version>
        <Authors>Felipe Rafael Montenegro Morriberon</Authors>
        <Copyright>Copyright © 2026 - FM. All rights reserved.</Copyright>

        <!-- Repository -->
        <RepositoryUrl>https://github.com/UBF21/vali-flow</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://vali-flow-docs.netlify.app/docs/adapters/ef-core</PackageProjectUrl>

        <!-- License -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- Discoverability -->
        <PackageTags>vali;vali-flow;efcore;entity-framework;specification;repository;query;filter;pagination;bulk;dotnet</PackageTags>
        <PackageIcon>VF_logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Source Link / Symbols -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <Description>Vali-Flow is a .NET library that simplifies data access in Entity Framework Core applications via a fluent specification API. Provides ValiFlowEvaluator for querying and writing data, QuerySpecification and BasicSpecification for defining query criteria, and bulk operation support via EFCore.BulkExtensions.</Description>
        <PackageReleaseNotes>v1.3.4 — Updated Vali-Flow.Core dependency to 2.0.2 (fixes IsNull/NotNull WHERE 0=1 bug with EF Core GlobalQueryFilter). No API changes.

v1.3.3 — Updated Vali-Flow.Core dependency to 2.0.1.

v1.3.0 — Made ValiFlowEvaluator&lt;T&gt; inheritable (removed sealed modifier). This allows repositories to extend ValiFlowEvaluator directly instead of using composition, enabling a cleaner repository pattern implementation. No breaking changes.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.0" />
        <PackageReference Include="EFCore.BulkExtensions" Version="8.1.3" />
        <ProjectReference Include="../../Vali-Flow.Core/Vali-Flow.Core/Vali-Flow.Core.csproj" />
        <PackageReference Include="Vali-Flow.Abstractions" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="VF_logo.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
