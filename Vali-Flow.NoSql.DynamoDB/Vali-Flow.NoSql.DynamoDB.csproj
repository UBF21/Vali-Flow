<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vali_Flow.NoSql.DynamoDB</RootNamespace>
    <PackageId>Vali-Flow.NoSql.DynamoDB</PackageId>
    <Version>1.1.0</Version>
    <Authors>Felipe Rafael Montenegro Morriberon</Authors>
    <Title>Vali-Flow.NoSql.DynamoDB</Title>
    <Description>AWS DynamoDB adapter for Vali-Flow.NoSql — translates the provider-agnostic IR tree into DynamoDB FilterExpression strings with ExpressionAttributeNames and ExpressionAttributeValues. Use .ToDynamoDB() on any ValiFlow&lt;T&gt; or Expression&lt;Func&lt;T, bool&gt;&gt;.</Description>
    <Copyright>Copyright © 2025 - FM. Todos los derechos reservados.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://vali-flow-docs.netlify.app/docs/adapters/nosql/dynamodb/overview</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UBF21/vali-flow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>VF_logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>vali;vali-flow;dynamodb;aws;filter;nosql;dotnet</PackageTags>
    <PackageReleaseNotes">v1.1.0 — Enhanced documentation and adapter integration pattern alignment.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="VF_logo.png" Condition="Exists('VF_logo.png')">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Vali-Flow.NoSql" Version="1.1.0" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.406.1" />
  </ItemGroup>

</Project>
