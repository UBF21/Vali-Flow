<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vali_Flow.NoSql.Redis</RootNamespace>
    <PackageId>Vali-Flow.NoSql.Redis</PackageId>
    <Version>1.0.0</Version>
    <Authors>Felipe Rafael Montenegro Morriberon</Authors>
    <Description>Redis (RediSearch) adapter for Vali-Flow.NoSql — translates the provider-agnostic IR tree into RediSearch query strings compatible with NRedisStack.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vali-Flow.NoSql\Vali-Flow.NoSql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NRedisStack" Version="1.3.0" />
  </ItemGroup>
</Project>
